{
  "name": "selfdash",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/server.js",
    "build": "node build.js",
    "pretest": "node build.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.mjs\" \"test/api/**/*.test.mjs\"",
    "test:unit": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.mjs\"",
    "test:api": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/api/**/*.test.mjs\"",
    "test:e2e": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/e2e/**/*.test.mjs\"",
    "test:all": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/**/*.test.mjs\"",
    "test:watch": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test --watch \"test/unit/**/*.test.mjs\" \"test/api/**/*.test.mjs\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "archiver": "^8.0.0",
    "fastify": "^5.0.0",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.1",
    "esbuild": "^0.24.0",
    "preact": "^10.29.8"
  }
}
