# Copy to .env and fill in. .env is git-ignored.
#
# APP_SECRET encrypts stored integration credentials at rest (AES-256-GCM).
# Generate one with:  openssl rand -hex 32
# Leave unset to store integration config as plaintext.
# Changing it after integrations are configured makes existing credentials
# undecryptable — re-enter them in the UI.
APP_SECRET=

# PUID / PGID: uid/gid that should own the ./data directory (the container starts
# as root, chowns it, then drops to this user). Default 1000. Set to `id -u` /
# `id -g` of the host user that owns the stack directory if that isn't 1000.
PUID=1000
PGID=1000

# COMPOSE_SCAN_DIR: absolute host path to your Docker Compose stacks directory,
# mounted read-only into the container at the same path for the "Docker Compose
# scan" feature. Set the same value in Settings → Compose scan dir. Unset/empty
# falls back to /compose-stacks (Docker creates it empty, so the scan just finds
# nothing). Remove the mount line in docker-compose.yml to opt out entirely.
COMPOSE_SCAN_DIR=
